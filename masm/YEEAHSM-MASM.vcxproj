<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{D839E34F-FB6C-41AC-9F62-C09C6FF5DEA6}</ProjectGuid>
    <RootNamespace>YEEAHSMMASM</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
    <Import Project="$(VCTargetsPath)\BuildCustomizations\masm.props" />
  </ImportGroup>
  <PropertyGroup>
    <!-- No CRT, no C++ project defaults to inherit from: this is a pure
         MASM build, so nothing here is copied from the main YEEAHSM.vcxproj. -->
    <GenerateManifest>false</GenerateManifest>
    <TargetExt>.asi</TargetExt>
    <OutDir>$(SolutionDir)bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <MASM>
      <UseSafeExceptionHandlers>false</UseSafeExceptionHandlers>
    </MASM>
    <Link>
      <SubSystem>Windows</SubSystem>
      <EntryPointSymbol>DllMain</EntryPointSymbol>
      <!-- Only kernel32 is ever called: override the toolset's default
           Win32 lib list (user32/gdi32/ole32/...) instead of inheriting it. -->
      <AdditionalDependencies>kernel32.lib</AdditionalDependencies>
      <GenerateDebugInformation>false</GenerateDebugInformation>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <DynamicBase>true</DynamicBase>
      <RandomizedBaseAddress>true</RandomizedBaseAddress>
      <!-- Fold .rdata (import name/hint tables) and .data (one DWORD) into
           .text. Each of the 3 original sections burned a full 512-byte
           FileAlignment block regardless of how little it held, so one
           merged section needs far fewer blocks total. The Import Address
           Table itself stays in its own .idata section regardless; the
           linker won't merge that one, by design.
           /SECTION:.text,RWE is required here, not optional: /MERGE only
           unions section CONTENT, not characteristics, so without it the
           merged section inherits .text's Execute+Read only, silently
           stripping Write from the folded-in g_oldProtect. That variable
           is written by VirtualProtect itself (the lpflOldProtect out
           param), so without this flag the first patch attempt at runtime
           access-violates on a read-only page. Trade-off: the section is
           now genuinely W+X, which some AV/EDR heuristics flag on
           principle even though nothing here relies on writable code. -->
      <AdditionalOptions>/MERGE:.rdata=.text /MERGE:.data=.text /SECTION:.text,RWE %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <MASM Include="main.asm" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
    <Import Project="$(VCTargetsPath)\BuildCustomizations\masm.targets" />
  </ImportGroup>
</Project>
